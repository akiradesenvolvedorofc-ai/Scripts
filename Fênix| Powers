local function makeEffectPart(parent, name, size, color, transparency, material, cframe)
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.Color = color
    part.Transparency = transparency
    part.Material = material
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CastShadow = false
    part.CFrame = cframe
    part.Parent = parent
    return part
end

local function beginDomain(name, duration, settings)
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local TweenService = game:GetService("TweenService")
    local Lighting = game:GetService("Lighting")
    local origin = root.Position
    local domain = Instance.new("Folder")
    domain.Name = name
    domain.Parent = workspace

    local oldLighting = {
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        Brightness = Lighting.Brightness,
        ClockTime = Lighting.ClockTime,
        FogColor = Lighting.FogColor,
        FogEnd = Lighting.FogEnd
    }

    settings = settings or {}
    Lighting.Ambient = settings.ambient or Color3.fromRGB(12, 12, 30)
    Lighting.OutdoorAmbient = settings.outdoor or Color3.fromRGB(20, 20, 60)
    Lighting.Brightness = settings.brightness or 1
    Lighting.ClockTime = settings.clockTime or 0
    Lighting.FogColor = settings.fogColor or Color3.fromRGB(30, 30, 90)
    Lighting.FogEnd = settings.fogEnd or 240

    local colorCorrection = Instance.new("ColorCorrectionEffect")
    colorCorrection.Name = name .. "Color"
    colorCorrection.TintColor = settings.tint or Color3.fromRGB(180, 190, 255)
    colorCorrection.Contrast = settings.contrast or 0.35
    colorCorrection.Saturation = settings.saturation or -0.15
    colorCorrection.Brightness = settings.colorBrightness or -0.05
    colorCorrection.Parent = Lighting

    local bloom = Instance.new("BloomEffect")
    bloom.Name = name .. "Bloom"
    bloom.Intensity = settings.bloom or 1.8
    bloom.Size = settings.bloomSize or 36
    bloom.Threshold = 0.7
    bloom.Parent = Lighting

    local blur = Instance.new("BlurEffect")
    blur.Name = name .. "Blur"
    blur.Size = 0
    blur.Parent = Lighting

    local function animate(instance, time, properties, delayTime)
        if not instance or not instance.Parent then return end
        local tween = TweenService:Create(
            instance,
            TweenInfo.new(time, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, 0, false, delayTime or 0),
            properties
        )
        tween:Play()
        return tween
    end

    animate(blur, 0.3, {Size = settings.blur or 5})

    local finished = false
    local function finish(onFinish)
        if finished then return end
        finished = true

        task.delay(duration, function()
            if onFinish then
                pcall(onFinish)
            end

            animate(blur, 0.45, {Size = 0})
            animate(colorCorrection, 0.55, {
                TintColor = Color3.new(1, 1, 1),
                Contrast = 0,
                Saturation = 0,
                Brightness = 0
            })
            animate(bloom, 0.55, {Intensity = 0})
            task.wait(0.7)

            if domain.Parent then domain:Destroy() end
            if blur.Parent then blur:Destroy() end
            if colorCorrection.Parent then colorCorrection:Destroy() end
            if bloom.Parent then bloom:Destroy() end

            Lighting.Ambient = oldLighting.Ambient
            Lighting.OutdoorAmbient = oldLighting.OutdoorAmbient
            Lighting.Brightness = oldLighting.Brightness
            Lighting.ClockTime = oldLighting.ClockTime
            Lighting.FogColor = oldLighting.FogColor
            Lighting.FogEnd = oldLighting.FogEnd
        end)
    end

    return player, character, root, domain, origin, animate, finish
end

local Button = Tab:Button({
    Title = "Técnica Vazia: Roxo",
    Desc = "Sequência completa: Azul + Vermelho = Roxo",
    Callback = function()
        local player = game.Players.LocalPlayer
        local char = player.Character
        local root = char.HumanoidRootPart
        local ts = game:GetService("TweenService")

        -- Função para criar as esferas de energia
        local function createEnergy(color, offset)
            local p = Instance.new("Part", workspace)
            p.Shape = Enum.PartType.Ball
            p.Size = Vector3.new(1, 1, 1)
            p.Color = color
            p.Material = Enum.Material.Neon
            p.CanCollide = false
            p.Anchored = true
            p.CFrame = root.CFrame * offset
            return p
        end

        -- 1. SPAWN AZUL E VERMELHO
        local azul = createEnergy(Color3.fromRGB(0, 0, 255), CFrame.new(-3, 2, -4))
        local vermelho = createEnergy(Color3.fromRGB(255, 0, 0), CFrame.new(3, 2, -4))

        -- Animação de crescimento e brilho
        ts:Create(azul, TweenInfo.new(0.5), {Size = Vector3.new(3, 3, 3)}):Play()
        ts:Create(vermelho, TweenInfo.new(0.5), {Size = Vector3.new(3, 3, 3)}):Play()
        
        task.wait(0.6)

        -- 2. FUSÃO (As duas bolas vão para o centro)
        local centroPos = root.CFrame * CFrame.new(0, 2, -6)
        ts:Create(azul, TweenInfo.new(0.4, Enum.EasingStyle.Back), {CFrame = centroPos}):Play()
        ts:Create(vermelho, TweenInfo.new(0.4, Enum.EasingStyle.Back), {CFrame = centroPos}):Play()
        
        task.wait(0.4)
        azul:Destroy()
        vermelho:Destroy()

        -- 3. CRIAÇÃO DO ROXO (Murasaki)
        local purple = Instance.new("Part", workspace)
        purple.Shape = Enum.PartType.Ball
        purple.Size = Vector3.new(2, 2, 2)
        purple.Color = Color3.fromRGB(138, 43, 226)
        purple.Material = Enum.Material.Neon
        purple.CanCollide = false
        purple.CFrame = centroPos
        purple.Anchored = false

        -- Efeito de explosão no nascimento do roxo
        ts:Create(purple, TweenInfo.new(0.3), {Size = Vector3.new(8, 8, 8)}):Play()

        local bv = Instance.new("BodyVelocity", purple)
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = root.CFrame.LookVector * 120 -- Velocidade rápida

        -- 4. RASTRO DE BLOCOS DO CHÃO (CRATERA)
        task.spawn(function()
            while purple and purple.Parent do
                local rayParam = RaycastParams.new()
                rayParam.FilterDescendantsInstances = {char, purple}
                local ray = workspace:Raycast(purple.Position, Vector3.new(0, -20, 0), rayParam)

                if ray then
                    -- Criar múltiplos blocos para parecer destruição real
                    for i = 1, 3 do
                        local rock = Instance.new("Part", workspace)
                        rock.Size = Vector3.new(math.random(3,6), math.random(3,6), math.random(3,6))
                        rock.Position = ray.Position + Vector3.new(math.random(-5,5), -2, math.random(-5,5))
                        rock.Color = ray.Instance.Color
                        rock.Material = ray.Instance.Material
                        rock.Anchored = true
                        rock.Orientation = Vector3.new(math.random(-180,180), math.random(-180,180), math.random(-180,180))
                        
                        -- Faz a rocha subir rápido e depois sumir
                        ts:Create(rock, TweenInfo.new(0.2), {CFrame = rock.CFrame * CFrame.new(0, 5, 0)}):Play()
                        game.Debris:AddItem(rock, 2)
                    end
                end
                task.wait(0.05) -- Frequência alta de blocos
            end
        end)

        -- 5. DANO EM ÁREA
        purple.Touched:Connect(function(hit)
            if hit.Parent:FindFirstChild("Humanoid") and hit.Parent.Name ~= player.Name then
                hit.Parent.Humanoid:TakeDamage(150)
            end
        end)

        game.Debris:AddItem(purple, 4)
    end
})

