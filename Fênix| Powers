        elseif hero.kind == "groot" then
            for i = 1, 8 do
                local angle = ((i - 1) / 8) * math.pi * 2
                local rootPart = heroPart("GrootRoot", Vector3.new(2, 2, 2), hero.accent, Enum.Material.Wood, CFrame.new(root.Position + Vector3.new(math.cos(angle) * 15, -2, math.sin(angle) * 15)), 0)
                TweenService:Create(rootPart, TweenInfo.new(0.55, Enum.EasingStyle.Back), {
                    Size = Vector3.new(3, 24, 3),
                    CFrame = rootPart.CFrame * CFrame.new(0, 11, 0)
                }):Play()
                Debris:AddItem(rootPart, 2.5)
            end
            damageInRadius(root.Position, 28, 58)
        end

        WindUI:Notify({Title = hero.name .. " — " .. hero.power, Content = "Poder ativado!", Icon = "zap", Duration = 2})
    end

    local sections = {}
    for _, hero in ipairs(heroes) do
        local heroRef = hero
        if not sections[heroRef.group] then
            sections[heroRef.group] = MarvelTab:Section({
                Title = heroRef.group,
                Opened = true
            })
        end

        local section = sections[heroRef.group]
        section:Keybind({
            Title = heroRef.name .. " — Transformar",
            Desc = "Ativa a skin e os atributos do herói",
            Value = heroRef.transformKey,
            Callback = function()
                transformHero(heroRef)
            end
        })

        section:Keybind({
            Title = heroRef.name .. " — " .. heroRef.power,
            Desc = "Poder principal: tecla " .. heroRef.powerKey,
            Value = heroRef.powerKey,
            Callback = function()
                usePower(heroRef)
            end
        })

        if heroRef.kind == "spider" then
            for _, extra in ipairs(heroRef.extraKeys) do
                local extraName = extra[1]
                local extraKey = extra[2]
                section:Keybind({
                    Title = "Homem-Aranha — " .. extraName,
                    Desc = "Habilidade especial",
                    Value = extraKey,
                    Callback = function()
                        if extraKey == "C" then
                            toggleWallClimb()
                        elseif activeHero == heroRef then
                            local _, root = getCharacter()
                            if root then
                                heroPulse(root.Position + root.CFrame.LookVector * 8, heroRef.accent, 28, 45)
                                root.AssemblyLinearVelocity = root.CFrame.LookVector * 70
                            end
                        end
                    end
                })
            end
        end
    end

    local resetSection = MarvelTab:Section({
        Title = "Controle",
        Opened = true
    })
    resetSection:Keybind({
        Title = "Voltar ao Humano",
        Desc = "Remove a skin, aura e os atributos do herói",
        Value = "Backspace",
        Callback = function()
            clearHero()
            WindUI:Notify({Title = "Marvel", Content = "Transformação removida.", Icon = "user", Duration = 2})
        end
    })
end

