            return
        end

        local character, root = getCharacter()
        if not root then return end

        if def.kind == "fire" then
            projectile(root, def.accent, Enum.Material.Neon, 3, 115, 35)
            pulse(root.Position + root.CFrame.LookVector * 14, def.color, 18, 25)
        elseif def.kind == "strength" then
            pulse(root.Position, def.accent, 38, 65)
            root.AssemblyLinearVelocity = Vector3.new(0, 75, 0)
        elseif def.kind == "speed" then
            local start = root.Position
            root.AssemblyLinearVelocity = root.CFrame.LookVector * 150
            pulse(start, def.accent, 22, 20)
            task.delay(0.55, function()
                if root and root.Parent then pulse(root.Position, def.color, 28, 30) end
            end)
        elseif def.kind == "crystal" then
            crystalSpikes(root.Position, def.accent)
        elseif def.kind == "fly" then
            root.AssemblyLinearVelocity = root.CFrame.LookVector * 85 + Vector3.new(0, 55, 0)
            for i = 1, 3 do
                projectile(root, def.accent, Enum.Material.SmoothPlastic, 2, 80 + i * 12, 24)
            end
        elseif def.kind == "ghost" then
            pulse(root.Position, def.accent, 32, 30)
            for part in pairs(originalParts) do
                if part and part.Parent then part.Transparency = 0.55 end
            end
            task.delay(4, function()
                if activeAlien == def then
                    for part, data in pairs(originalParts) do
