        shot.CanCollide = false
        shot.CFrame = root.CFrame * CFrame.new(0, 0, -5)
        shot.Parent = workspace
        shot.AssemblyLinearVelocity = root.CFrame.LookVector * speed

        local connection
        connection = shot.Touched:Connect(function(hit)
            local target = hit:FindFirstAncestorOfClass("Model")
            local humanoid = target and target:FindFirstChildOfClass("Humanoid")
            if humanoid and target ~= localPlayer.Character then
                humanoid:TakeDamage(damage)
                pulse(shot.Position, color, size * 5, damage)
                connection:Disconnect()
                shot:Destroy()
            end
        end)
        Debris:AddItem(shot, 4)
    end

    local function crystalSpikes(position, color)
        for i = 1, 9 do
            local angle = ((i - 1) / 9) * math.pi * 2
            local spike = Instance.new("Part")
            spike.Name = "DiamondSpike"
            spike.Size = Vector3.new(2, 2, 2)
            spike.Color = color
            spike.Material = Enum.Material.Glass
            spike.Anchored = true
            spike.CanCollide = false
            spike.CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * 13, -2, math.sin(angle) * 13))
            spike.Parent = workspace
            TweenService:Create(spike, TweenInfo.new(0.45, Enum.EasingStyle.Back), {
                Size = Vector3.new(3, 22, 3),
                CFrame = spike.CFrame * CFrame.new(0, 10, 0)
            }):Play()
            Debris:AddItem(spike, 2.5)
        end
        damageInRadius(position, 28, 42)
    end

    local function usePower(def)
        if activeAlien ~= def then
            WindUI:Notify({
                Title = "Transforme-se primeiro",
                Content = "Ative " .. def.name .. " antes de usar o poder.",
                Icon = "alert-triangle",
                Duration = 3
