        stopWallClimb()
        if heroFolder and heroFolder.Parent then heroFolder:Destroy() end
        heroFolder = nil

        for part, data in pairs(savedHeroParts) do
            if part and part.Parent then
                part.Color = data.Color
                part.Material = data.Material
                part.Transparency = data.Transparency
            end
        end

        local character, _, humanoid = getCharacter()
        if humanoid and character == activeCharacter then
            humanoid.WalkSpeed = savedWalkSpeed
            humanoid.JumpPower = savedJumpPower
            humanoid.AutoRotate = true
        end
        activeHero = nil
    end

    local function transformHero(hero)
        local character, root, humanoid = getCharacter()
        if not root or not humanoid then return end

        if activeCharacter ~= character then
            savedHeroParts = {}
            activeCharacter = character
        end
        clearHero()

        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                savedHeroParts[part] = {
                    Color = part.Color,
                    Material = part.Material,
                    Transparency = part.Transparency
                }
                part.Color = hero.color
                part.Material = hero.material

                if hero.kind == "spider" then
                    if string.find(part.Name, "Leg") or string.find(part.Name, "Torso") then
                        part.Color = hero.accent
                    end
                elseif hero.kind == "ironman" and string.find(part.Name, "Head") then
                    part.Color = hero.accent
                elseif hero.kind == "captain" and string.find(part.Name, "Torso") then
                    part.Color = hero.accent
                end
            end
        end

        savedWalkSpeed = humanoid.WalkSpeed
        savedJumpPower = humanoid.JumpPower
        humanoid.WalkSpeed = hero.speed
        humanoid.JumpPower = hero.jump
