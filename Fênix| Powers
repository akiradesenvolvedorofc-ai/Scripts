                    end
                end
            end)
        elseif def.kind == "water" then
            projectile(root, def.accent, Enum.Material.Glass, 5, 75, 50)
            pulse(root.Position + root.CFrame.LookVector * 12, def.color, 30, 38)
        elseif def.kind == "smart" then
